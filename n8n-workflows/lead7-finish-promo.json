    {
      "parameters": {
        "jsCode": "const userId = $input.first().json.id;\nconst code = 'MARATHON10-' + Math.random().toString(36).slice(2, 10).toUpperCase();\nreturn { json: { user_id: userId, code } };"
      },
      "id": "code-generate",
